/** Dev-only endpoint listing agent-generated (or manually dropped) creative assets. See vle-editor/devGate / vle-editor/creativesScan. */
import { NextRequest, NextResponse } from "next/server";
import { devGate } from "vle-editor/devGate";
import { scanCreatives } from "vle-editor/creativesScan";
import { vleConfig } from "@/vle.config";

export async function GET(req: NextRequest) {
  const blocked = devGate(req);
  if (blocked) return blocked;

  const assets = scanCreatives(vleConfig);
  return NextResponse.json({ ok: true, assets });
}
