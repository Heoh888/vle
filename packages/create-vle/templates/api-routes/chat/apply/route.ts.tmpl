/** Applies a chat session's accumulated diff to the live repo and ends the session. See vle-editor/devGate / vle-editor/chatRunner. */
import { NextRequest, NextResponse } from "next/server";
import { devGate } from "vle-editor/devGate";
import { applyChatSession } from "vle-editor/chatRunner";
import { vleConfig } from "@/vle.config";

export async function POST(req: NextRequest) {
  const blocked = devGate(req);
  if (blocked) return blocked;

  let body: { chatId?: string };
  try {
    body = await req.json();
  } catch {
    return NextResponse.json({ ok: false, reason: "invalid JSON body" }, { status: 400 });
  }

  if (!body.chatId) {
    return NextResponse.json({ ok: false, reason: "missing chatId" }, { status: 400 });
  }

  const result = applyChatSession(body.chatId, vleConfig.repoRoot);
  return NextResponse.json(result, { status: result.ok ? 200 : 422 });
}
